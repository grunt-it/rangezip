{
  "name": "rangezip",
  "version": "0.1.0",
  "description": "Extract individual files from a huge remote ZIP on Cloudflare Workers using HTTP byte-range reads — without ever downloading the whole archive.",
  "license": "MIT",
  "author": "Nik Divjak",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "effect": "^3.21.2",
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20260522.1",
    "@img/sharp-libvips-darwin-arm64": "^1.2.4",
    "@types/node": "^25.9.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
